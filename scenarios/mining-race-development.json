{
  "schema_version": 1,
  "name": "mining-race-development",
  "network": {
    "profile": "development",
    "step_timeout_ms": 300000
  },
  "actors": [
    {"name": "full-node", "roles": ["full_node"], "control": "127.0.0.1:0", "p2p": "127.0.0.1:0"},
    {"name": "miner-a", "roles": ["wallet", "miner"], "control": "127.0.0.1:0", "mining_source": "full-node"},
    {"name": "miner-b", "roles": ["wallet", "miner"], "control": "127.0.0.1:0", "mining_source": "full-node"}
  ],
  "steps": [
    {"command": "start_all"},
    {"wait": "all_ready"},
    {"command": "connect_all"},
    {"wait": "full_nodes_connected"},
    {"command": "start_mining", "actors": ["miner-a", "miner-b"]},
    {"wait": "mining_complete", "height": 1},
    {"command": "dump", "actors": "all"}
  ],
  "assertions": [
    {"all_ready": true},
    {"height": {"actors": ["full-node"], "value": 1}},
    {"peer_count": {"actor": "full-node", "value": 2}},
    {"mining_outcome": {"actors": ["miner-a", "miner-b"]}},
    {"winner_reward": {"miners": ["miner-a", "miner-b"], "full_node": "full-node", "amount": 5000000000}}
  ]
}
